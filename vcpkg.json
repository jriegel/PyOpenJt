{
  "name": "pyopenjt",
  "version-string": "0.0.0",
  "dependencies": [
    "eigen3",
    "tbb",
    "tinygltf",
    "liblzma",
    "zlib",
    "draco"
  ],
  "default-features": [
    "tools",
    "viewer"
  ],
  "features": {
    "tools": {
      "description": "Command line tools (JtDump)",
      "dependencies": [
        "cli11"
      ]
    },
    "viewer": {
      "description": "JTAssistant Qt viewer",
      "dependencies": [
        "qt5-base",
        "qt5-tools"
      ]
    }
  }
}
