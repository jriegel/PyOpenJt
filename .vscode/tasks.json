{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build JtDump",
      "type": "shell",
      "command": "cmake --build WinBuild --config Debug --target JtDump",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
